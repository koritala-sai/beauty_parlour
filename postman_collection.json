{
  "info": {
    "name": "Glow Studio - Beauty Parlour API",
    "description": "CRUD endpoints for services, bookings, and users. Base URL assumes the Flask app is running locally on port 5000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:5000" }
  ],
  "item": [
    {
      "name": "Services",
      "item": [
        {
          "name": "Get all services",
          "request": { "method": "GET", "url": "{{base_url}}/api/services" }
        },
        {
          "name": "Get one service",
          "request": { "method": "GET", "url": "{{base_url}}/api/services/1" }
        },
        {
          "name": "Create service",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/services",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Haircut\",\n  \"category\": \"Hair\",\n  \"description\": \"Basic haircut and styling\",\n  \"price\": 300,\n  \"duration_minutes\": 30\n}"
            }
          }
        },
        {
          "name": "Update service",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/services/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 350\n}"
            }
          }
        },
        {
          "name": "Delete service",
          "request": { "method": "DELETE", "url": "{{base_url}}/api/services/1" }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Get all bookings",
          "request": { "method": "GET", "url": "{{base_url}}/api/bookings" }
        },
        {
          "name": "Get one booking",
          "request": { "method": "GET", "url": "{{base_url}}/api/bookings/1" }
        },
        {
          "name": "Create booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"service_id\": 1,\n  \"booking_date\": \"2026-08-10\",\n  \"booking_time\": \"14:30\"\n}"
            }
          }
        },
        {
          "name": "Update booking status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/bookings/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            }
          }
        },
        {
          "name": "Delete booking",
          "request": { "method": "DELETE", "url": "{{base_url}}/api/bookings/1" }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get all users",
          "request": { "method": "GET", "url": "{{base_url}}/api/users" }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9999999999\"\n}"
            }
          }
        }
      ]
    }
  ]
}
